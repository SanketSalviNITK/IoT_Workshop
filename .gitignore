# =========================================================================
# "The Last Beacon" GitHub Repository Exclusions (.gitignore)
# =========================================================================

# 1. Sensitive Overleaf Credentials & CLI Metadata
.ol*
olcli*
.olauth
.olproject
.olignore
.olcli.json

# 2. Academic Manuscript & Publication Files
LastBeacon_Paper/
publication_assets/
presentation/
"book assets"/
book assets/

# 3. Unnecessary Libraries & Node Packages
node_modules/
**/node_modules/
package-lock.json

# 4. Local System Cache & Temp Logs
error.log
*.log
.DS_Store
Thumbs.db

# 5. LaTeX Output & Temporary Compile Artifacts
*.aux
*.out
*.toc
*.nav
*.snm
*.vrb
*.gz
*.fdb_latexmk
*.fls